# -----------------------------------------------------------------------------
# GovPolicy AI - Environment Configurations & Secrets
# -------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Agentic Policy Data Analytics Platform"
DATABASE_URL=sqlite:///./backend_data.db

# -----------------------------------------------------------------------------
# Multi-Cloud LLM Provider Credentials
# -----------------------------------------------------------------------------

# 1. OpenAI (Default: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 2. Google Cloud Gemini (Default: gemini-1.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. AWS Bedrock (Default: Claude 3.5 Sonnet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# -----------------------------------------------------------------------------
# Automated LLM Router Fallback Order
# Priority: attempts first provider; cascades down if rate-limited, unauthorized, or offline.
# The Local Deterministic Fallback Engine guarantees 100% uptime even if all keys are blank!
# -----------------------------------------------------------------------------
LLM_PROVIDER_PRIORITY=["openai", "gemini", "bedrock", "local_fallback"]
